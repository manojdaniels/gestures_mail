# Core
STORAGE_DIR=/workspace/data
LOG_LEVEL=INFO

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM (optional)
OPENAI_API_KEY=

# TTS (optional)
ELEVENLABS_API_KEY=
TTS_VOICE=en

# YouTube API
YOUTUBE_CLIENT_SECRETS_FILE=/workspace/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/workspace/data/tokens/token.json
YOUTUBE_DEFAULT_CATEGORY_ID=27

# Scheduler
TIMEZONE=UTC